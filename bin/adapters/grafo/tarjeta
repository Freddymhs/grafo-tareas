#!/usr/bin/env bash
# tarjeta — la TAREA `[<id>] <título>` de una task en el grafo, con la etiqueta del contrato, en la primera
# etapa (`secciones.entendimiento`). Idempotente: si ya hay una `[<id>]` abierta no crea otra (nunca dos
# por id). Lo pide /flow:pbi:get paso 7 y repartir al tomar una pieza.
#
#   tarjeta <id> <título corto>      → `<nodo_id>\t<titulo>\t<creada|existía>`
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/lib/tablero.sh"
ID="${1:?uso: tarjeta <id> <título>}"; TITULO="${2:?falta el título}"

EXISTENTE=$(nodo_por_prefijo "[$ID]" TAREA)
if [ -n "$EXISTENTE" ]; then
  printf '%s\texistía\n' "$(printf '%s' "$EXISTENTE" | linea)"
  exit 0
fi
CUERPO=$(jq -nc --arg ti "[$ID] $TITULO" --arg et "$(cfg secciones.entendimiento)" --arg e "$(cfg label)" \
  '{tipo: "TAREA", titulo: $ti, etapa: $et, etiquetas: [$e]}')
printf '%s\tcreada\n' "$(gr_crear "$CUERPO" | linea)"
