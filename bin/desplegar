#!/usr/bin/env bash
# desplegar — el camino A MANO al Mac Mini (emergencia). El de todos los días es el push: el job `deploy` del CI de api,
# web y vr corre deploy/desplegar-aqui.sh en el runner del Mac Mini (FASE 27). Este script corre ese MISMO archivo, por ssh:
#
#   1. aquí: lo que no está en GitHub no se despliega → aborta si algún `main` local va adelante de origin
#   2. allá (ssh): deploy/desplegar-aqui.sh tal como está en origin/main — trae los repos, compose, tailscale serve y
#      la verificación por el tailnet (health, PWA, VR, CORS, puertos solo en 127.0.0.1, restart unless-stopped)
set -euo pipefail

ORQ="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Dónde corre sale de refs.yaml (`despliegue`), no de este script: lo leen también probar-en-visor y el corte.
HOST_SSH="${GRAFO_HOST_SSH:-$(REF_DESDE="$ORQ" ref despliegue.ssh)}" || { echo "desplegar: falta despliegue.ssh en refs.yaml" >&2; exit 1; }
REPOS_INTERNOS=(grafo-tareas.api grafo-tareas.web grafo-tareas.vr)
RAMA=main
INTENTOS_GIT=3

falla() { echo "desplegar: $*" >&2; exit 1; }
reintentar() {   # GitHub corta a veces el ssh (`Connection reset by peer`, medido 2026-10-17): un corte no es un error
  local n
  for n in $(seq "$INTENTOS_GIT"); do "$@" && return 0; echo "reintento $n/$INTENTOS_GIT: $*" >&2; sleep 5; done
  return 1
}

# 1. Lo publicado es lo que se despliega.
for repo in "" "${REPOS_INTERNOS[@]}"; do
  dir="$ORQ${repo:+/$repo}"; nombre="${repo:-grafo-tareas}"
  reintentar git -C "$dir" fetch -q origin "$RAMA" || falla "no pude traer $nombre de GitHub"
  adelante=$(git -C "$dir" rev-list --count "origin/$RAMA..$RAMA")
  [ "$adelante" = 0 ] || falla "$nombre tiene $adelante commit(s) sin pushear: lo que no está en GitHub no se despliega"
  [ -z "$(git -C "$dir" status --porcelain)" ] || echo "aviso: $nombre tiene cambios sin commitear; no viajan (se despliega origin/$RAMA)"
done

# 2. En el Mac Mini, el script publicado.
git -C "$ORQ" show "origin/$RAMA:deploy/desplegar-aqui.sh" | ssh "$HOST_SSH" bash -s
