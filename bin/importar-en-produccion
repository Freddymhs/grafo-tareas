#!/usr/bin/env bash
# importar-en-produccion — corre los importadores de la API contra la base DESPLEGADA (FASE 12), no la del PC.
#
#   importar-en-produccion todoist --proyecto <id-de-todoist> [--seco]   (el `todoist.plan` del refs.yaml entra como plan)
#   importar-en-produccion fases <orquestador> [--proyecto <nombre>] [--adoptar <origen>] [--seco]
#
# todoist: el token viaja por stdin (sale de ~/.zsh_secrets; nunca en una línea de comandos ni en el Mac Mini).
# fases:   copia al Mac Mini SOLO lo que el importador lee —`FASE_*.md`, `Tareas/<id>/entendimiento.md` y el mapa
#          task → HU que lee del tracker del orquestador (`padres.json`, FASE 13)—, lo monta en
#          un contenedor de un solo uso de la API (`docker compose run`) y lo borra al terminar. El proyecto es la clave
#          `proyecto` del refs.yaml del orquestador (el origen `fases-md:<proyecto>`); los roles, los del despliegue.
# Siempre conviene `--seco` primero: cuenta contra la base real sin escribir (corre lo mismo y deshace la transacción).
set -euo pipefail

ORQ="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
desde_refs() { REF_DESDE="$ORQ" ref "despliegue.$1" || { echo "importar-en-produccion: falta despliegue.$1 en refs.yaml" >&2; exit 1; }; }
HOST_SSH="${GRAFO_HOST_SSH:-$(desde_refs ssh)}"
DIR_REMOTO="apps/$(desde_refs app)"
USO="uso: importar-en-produccion todoist --proyecto <id> [--seco] | fases <orquestador> [--proyecto <nombre>] [--adoptar <origen>] [--seco]"

falla() { echo "importar-en-produccion: $*" >&2; exit 1; }
# El mismo prólogo en cada ssh: PATH de docker (ssh no carga el .zshrc) y la carpeta del compose.
remoto() { ssh "$HOST_SSH" "export PATH=/usr/local/bin:\$PATH; cd \"\$HOME/$DIR_REMOTO/deploy\" && $1"; }

importar_todoist() {
  local proyecto="" seco=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --proyecto) proyecto="${2:?--proyecto pide el id}"; shift ;;
      --seco) seco=--seco ;;
      *) falla "$USO" ;;
    esac
    shift
  done
  [ -n "$proyecto" ] || falla "$USO"
  # FASE 17: el proyecto del plan («🚀 Draft trabajo») lo dice el refs.yaml, para no depender de acordarse de un flag.
  local cara=REAL
  if [ "$proyecto" = "$(REF_DESDE="$ORQ" ref todoist.plan 2>/dev/null || true)" ]; then cara=PLAN; fi
  # C10: «FASE 22» en una tarjeta es la FASE 22 del orquestador que dice el refs.yaml; sin esto, el tablero la duplica.
  local fases_de="" con_fases=""
  fases_de=$(REF_DESDE="$ORQ" ref todoist.fases_de 2>/dev/null || true)
  [ -z "$fases_de" ] || con_fases="--fases-de $fases_de"
  echo "importar-en-produccion: proyecto $proyecto → cara $cara${fases_de:+ · FASE de $fases_de}" >&2
  bash -c 'set +u; source ~/.zsh_secrets >/dev/null 2>&1; printf "%s\n" "${TODOIST_API_KEY:-}"' |
    remoto "read -r TODOIST_API_KEY; [ -n \"\$TODOIST_API_KEY\" ] || { echo 'sin TODOIST_API_KEY en ~/.zsh_secrets del PC' >&2; exit 1; }; export TODOIST_API_KEY; docker compose exec -T -e TODOIST_API_KEY api node dist/importadores/todoist/cli.js --proyecto '$proyecto' --cara $cara $con_fases $seco"
}

# FASE 13: el mapa task → HU (y el título de cada HU) sale del TRACKER del orquestador, con su propio adaptador y solo
# GET: la cabecera de la FASE lo dice en prosa y no siempre (21 de 35 en el Laboratorio, medido 2026-10-17). Hoy sabe
# leer Azure; otro tracker → las FASE quedan sin HU y se avisa. Sale por stdout el JSON { tareas, padres }.
padres_del_tracker() {   # padres_del_tracker <orquestador> <carpeta del backlog>
  local orq=$1 backlog=$2 kind adaptador tasks
  kind=$(REF_DESDE="$orq" ref tracker.kind 2>/dev/null) || { echo "aviso: $orq no declara tracker.kind: las FASE quedan sin HU" >&2; return 1; }
  [ "$kind" = azure ] || { echo "aviso: tracker «$kind»: el mapa de padres solo lee azure; las FASE quedan sin HU" >&2; return 1; }
  adaptador=$(dirname "$(REF_DESDE="$orq" ref tracker.item)")
  # La misma regla que leer-fase.ts: el primer número de la línea **Azure**.
  tasks=$(grep -h -m1 -E '^\*\*Azure\*\*' "$backlog"/FASE_*.md | grep -oE '^\*\*Azure\*\*:?[^0-9]*[0-9]{5,6}' \
    | grep -oE '[0-9]{5,6}$' | sort -u | paste -sd, -)
  [ -n "$tasks" ] || { echo "aviso: ninguna FASE nombra su task" >&2; return 1; }
  bash -s "$adaptador" "$tasks" <<'AZURE'
set -euo pipefail
source "$1/lib/azure.sh"
campos="System.Id,System.Parent,System.Title"
hijas=$(api "$ORG/wit/workitems?ids=$2&fields=$campos&api-version=7.0")
padres=$(jq -r '[.value[].fields["System.Parent"] // empty | tostring] | unique | join(",")' <<<"$hijas")
titulos='{"value":[]}'
[ -z "$padres" ] || titulos=$(api "$ORG/wit/workitems?ids=$padres&fields=$campos&api-version=7.0")
jq -n --argjson h "$hijas" --argjson p "$titulos" '{
  tareas: ($h.value | map(select(.fields["System.Parent"]) | {(.id | tostring): (.fields["System.Parent"] | tostring)}) | add // {}),
  padres: ($p.value | map({(.id | tostring): .fields["System.Title"]}) | add // {})
}'
AZURE
}

importar_fases() {
  local orquestador="${1:?$USO}"; shift
  local extra=() proyecto=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --proyecto) proyecto="${2:?--proyecto pide el nombre}"; shift ;;   # sin él, la clave `proyecto` de su refs.yaml
      --adoptar) extra+=(--adoptar "${2:?--adoptar pide el origen}"); shift ;;
      --seco) extra+=(--seco) ;;
      *) falla "$USO" ;;
    esac
    shift
  done
  orquestador="$(cd "$orquestador" && pwd)"
  local docs
  [ -n "$proyecto" ] || proyecto=$(REF_DESDE="$orquestador" ref proyecto) || falla "$orquestador/refs.yaml no tiene \`proyecto:\` (es el origen fases-md:<proyecto>)"
  docs=$(REF_DESDE="$orquestador" ref docs.dir) || falla "$orquestador/refs.yaml no tiene docs.dir"
  [ -d "$docs/backlog" ] || falla "no existe $docs/backlog"
  local carpeta="importar/$proyecto"   # relativa a deploy/ del Mac Mini (ignorada por git)

  remoto "rm -rf '$carpeta' && mkdir -p '$carpeta/backlog' '$carpeta/Tareas'"
  rsync -a --prune-empty-dirs --include='FASE_*.md' --exclude='*' "$docs/backlog/" "$HOST_SSH:$DIR_REMOTO/deploy/$carpeta/backlog/"
  [ -d "$orquestador/Tareas" ] && rsync -a --prune-empty-dirs --include='*/' --include='entendimiento.md' --exclude='*' \
    "$orquestador/Tareas/" "$HOST_SSH:$DIR_REMOTO/deploy/$carpeta/Tareas/"
  echo "copiado: $(remoto "find '$carpeta/backlog' -name 'FASE_*.md' | wc -l | tr -d ' '") FASE · $(remoto "find '$carpeta/Tareas' -name entendimiento.md | wc -l | tr -d ' '") entendimiento.md"
  local padres_local; padres_local=$(mktemp)
  if padres_del_tracker "$orquestador" "$docs/backlog" > "$padres_local"; then
    rsync -a "$padres_local" "$HOST_SSH:$DIR_REMOTO/deploy/$carpeta/padres.json"
    extra+=(--padres /importar/padres.json)
    echo "padres: $(jq '.tareas | length' "$padres_local") tasks → $(jq '.padres | length' "$padres_local") HU ($(jq -r '.padres | to_entries | map("\(.key) \(.value)") | join(" · ")' "$padres_local"))"
  fi
  rm -f "$padres_local"

  # Contenedor de un solo uso con la misma imagen y el mismo DATABASE_URL que la API; lo copiado, montado de solo lectura.
  remoto "docker compose run --rm -T -v \"\$PWD/$carpeta:/importar:ro\" api node dist/importadores/fases/cli.js \
    --backlog /importar/backlog --tareas /importar/Tareas --roles /area/roles.yaml --proyecto '$proyecto' ${extra[*]:-}; \
    estado=\$?; rm -rf '$carpeta'; exit \$estado"
}

modo="${1:-}"; [ $# -gt 0 ] && shift
case "$modo" in
  todoist) importar_todoist "$@" ;;
  fases) importar_fases "$@" ;;
  *) falla "$USO" ;;
esac
